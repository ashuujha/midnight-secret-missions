pragma language_version >= 0.23;

import CompactStandardLibrary;

// A stable player identity and a fresh mission/salt for each run live only in
// the player's browser. A challenge never discloses which visits were decoys.
witness identitySecret(): Bytes<32>;
witness hiddenMission(): Uint<8>;
witness missionSalt(): Bytes<32>;

export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger rounds: Map<Bytes<32>, Uint<16>>;
export ledger runStatus: Map<Bytes<32>, Uint<8>>; // 0 playing, 1 proved, 2 forfeited/expired
export ledger moveCounts: Map<Bytes<32>, Uint<8>>;
export ledger firstVisits: Map<Bytes<32>, Uint<8>>;
export ledger secondVisits: Map<Bytes<32>, Uint<8>>;
export ledger thirdVisits: Map<Bytes<32>, Uint<8>>;
export ledger fourthVisits: Map<Bytes<32>, Uint<8>>;
export ledger fifthVisits: Map<Bytes<32>, Uint<8>>;
export ledger scores: Map<Bytes<32>, Uint<16>>;
export ledger challengeTokens: Map<Bytes<32>, Uint<8>>;
export ledger challengeStatus: Map<Bytes<32>, Uint<8>>; // 0 none, 1 open, 2 runner won, 3 challenger won
export ledger challengeBy: Map<Bytes<32>, Bytes<32>>;
export ledger challengeDeadlines: Map<Bytes<32>, Uint<64>>;
export ledger playerCount: Counter;
export ledger completedMissions: Counter;
export ledger successfulChallenges: Counter;

export pure circuit playerId(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

export pure circuit missionCommitment(mission: Uint<8>, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Uint<8>>(mission, salt);
}

export pure circuit missionFirst(mission: Uint<8>): Uint<8> {
  if (mission == 0 || mission == 4) { return 0; }
  if (mission == 1 || mission == 5) { return 1; }
  if (mission == 2 || mission == 6) { return 2; }
  if (mission == 3) { return 3; }
  return 4;
}

export pure circuit missionSecond(mission: Uint<8>): Uint<8> {
  if (mission == 0) { return 1; }
  if (mission == 1 || mission == 4) { return 4; }
  if (mission == 2 || mission == 7) { return 0; }
  if (mission == 3 || mission == 5) { return 2; }
  return 3;
}

export pure circuit missionThird(mission: Uint<8>): Uint<8> {
  if (mission == 0 || mission == 7) { return 2; }
  if (mission == 1 || mission == 2 || mission == 5) { return 3; }
  if (mission == 3 || mission == 4) { return 1; }
  return 0;
}

export pure circuit orderedThree(
  a: Uint<8>, b: Uint<8>, c: Uint<8>,
  one: Uint<8>, two: Uint<8>, three: Uint<8>, four: Uint<8>, five: Uint<8>
): Boolean {
  return (one == a && two == b && three == c)
    || (one == a && two == b && four == c)
    || (one == a && two == b && five == c)
    || (one == a && three == b && four == c)
    || (one == a && three == b && five == c)
    || (one == a && four == b && five == c)
    || (two == a && three == b && four == c)
    || (two == a && three == b && five == c)
    || (two == a && four == b && five == c)
    || (three == a && four == b && five == c);
}

// A challenge lasts 20 minutes. The supplied start time must be within five
// minutes of chain time, leaving at least 15 minutes to finish and prove.
export circuit challenge(challengerId: Bytes<32>, targetId: Bytes<32>, startedAt: Uint<64>): [] {
  const challenger = disclose(challengerId);
  const target = disclose(targetId);
  const start = disclose(startedAt);
  assert(commitments.member(challenger), "Challenger must join first");
  assert(playerId(identitySecret()) == challenger, "Only the challenger can stake a token");
  assert(commitments.member(target), "Target player not found");
  assert(challenger != target, "Cannot challenge yourself");
  assert(runStatus.lookup(target) == 0, "Target run is already settled");
  assert(moveCounts.lookup(target) > 0, "Target must make a move first");
  assert(challengeStatus.lookup(target) == 0, "Target already has a challenge");
  assert(challengeTokens.lookup(challenger) > 0, "No challenge tokens left");
  assert(start <= 18446744073708351615, "Timestamp is too large");
  assert(blockTimeGte(start), "Challenge time is in the future");
  assert(blockTimeLt((start + 300000) as Uint<64>), "Challenge time is too old");
  challengeTokens.insert(challenger, (challengeTokens.lookup(challenger) - 1) as Uint<8>);
  challengeBy.insert(target, challenger);
  challengeDeadlines.insert(target, (start + 1200000) as Uint<64>);
  challengeStatus.insert(target, 1);
}

export circuit join(): [] {
  const secret = identitySecret();
  const mission = hiddenMission();
  assert(mission < 8, "Unknown mission");
  const id = disclose(playerId(secret));
  assert(!commitments.member(id), "Player already joined");
  commitments.insert(id, missionCommitment(mission, missionSalt()));
  rounds.insert(id, 1);
  runStatus.insert(id, 0);
  moveCounts.insert(id, 0);
  scores.insert(id, 0);
  challengeTokens.insert(id, 3);
  challengeStatus.insert(id, 0);
  playerCount.increment(1);
}

export circuit visit(id: Bytes<32>, location: Uint<8>): [] {
  const publicId = disclose(id);
  const publicLocation = disclose(location);
  assert(commitments.member(publicId), "Join the game first");
  assert(playerId(identitySecret()) == publicId, "Only the player can move");
  assert(publicLocation < 5, "Unknown location");
  assert(runStatus.lookup(publicId) == 0, "Run is already settled");
  if (challengeStatus.lookup(publicId) == 1) {
    assert(blockTimeLt(challengeDeadlines.lookup(publicId)), "Challenge deadline passed");
  }
  const count = moveCounts.lookup(publicId);
  assert(count < 5, "Five visits already recorded");
  if (count == 0) { firstVisits.insert(publicId, publicLocation); }
  if (count == 1) { secondVisits.insert(publicId, publicLocation); }
  if (count == 2) { thirdVisits.insert(publicId, publicLocation); }
  if (count == 3) { fourthVisits.insert(publicId, publicLocation); }
  if (count == 4) { fifthVisits.insert(publicId, publicLocation); }
  moveCounts.insert(publicId, (count + 1) as Uint<8>);
}

export circuit claim(id: Bytes<32>): [] {
  const publicId = disclose(id);
  assert(commitments.member(publicId), "Join the game first");
  const secret = identitySecret();
  const mission = hiddenMission();
  assert(playerId(secret) == publicId, "Only the player can claim");
  assert(mission < 8, "Unknown mission");
  assert(commitments.lookup(publicId) == missionCommitment(mission, missionSalt()), "Mission commitment mismatch");
  assert(runStatus.lookup(publicId) == 0, "Run is already settled");
  assert(moveCounts.lookup(publicId) == 5, "Complete five public visits first");
  if (challengeStatus.lookup(publicId) == 1) {
    assert(blockTimeLt(challengeDeadlines.lookup(publicId)), "Challenge deadline passed");
  }
  assert(orderedThree(
    missionFirst(mission), missionSecond(mission), missionThird(mission),
    firstVisits.lookup(publicId), secondVisits.lookup(publicId), thirdVisits.lookup(publicId),
    fourthVisits.lookup(publicId), fifthVisits.lookup(publicId)
  ), "Your public visits do not satisfy your secret mission");
  runStatus.insert(publicId, 1);
  scores.insert(publicId, (scores.lookup(publicId) + 1) as Uint<16>);
  if (challengeTokens.lookup(publicId) < 3) {
    challengeTokens.insert(publicId, (challengeTokens.lookup(publicId) + 1) as Uint<8>);
  }
  if (challengeStatus.lookup(publicId) == 1) { challengeStatus.insert(publicId, 2); }
  completedMissions.increment(1);
}

// A failed proof cannot appear on-chain. Missing the deadline or forfeiting is
// the observable loss condition. The stake is returned only in that case.
export circuit resolveChallenge(targetId: Bytes<32>): [] {
  const target = disclose(targetId);
  assert(commitments.member(target), "Target player not found");
  assert(runStatus.lookup(target) == 0, "Target run is already settled");
  assert(challengeStatus.lookup(target) == 1, "No open challenge");
  assert(blockTimeGte(challengeDeadlines.lookup(target)), "Proof window is still open");
  const challenger = challengeBy.lookup(target);
  scores.insert(challenger, (scores.lookup(challenger) + 1) as Uint<16>);
  if (challengeTokens.lookup(challenger) < 3) {
    challengeTokens.insert(challenger, (challengeTokens.lookup(challenger) + 1) as Uint<8>);
  }
  runStatus.insert(target, 2);
  challengeStatus.insert(target, 3);
  successfulChallenges.increment(1);
}

export circuit forfeit(id: Bytes<32>): [] {
  const publicId = disclose(id);
  assert(commitments.member(publicId), "Join the game first");
  assert(playerId(identitySecret()) == publicId, "Only the player can forfeit");
  assert(runStatus.lookup(publicId) == 0, "Run is already settled");
  if (challengeStatus.lookup(publicId) == 1) {
    const challenger = challengeBy.lookup(publicId);
    scores.insert(challenger, (scores.lookup(challenger) + 1) as Uint<16>);
    if (challengeTokens.lookup(challenger) < 3) {
      challengeTokens.insert(challenger, (challengeTokens.lookup(challenger) + 1) as Uint<8>);
    }
    challengeStatus.insert(publicId, 3);
    successfulChallenges.increment(1);
  }
  runStatus.insert(publicId, 2);
}

export circuit nextRound(id: Bytes<32>): [] {
  const publicId = disclose(id);
  assert(commitments.member(publicId), "Join the game first");
  assert(playerId(identitySecret()) == publicId, "Only the player can start another run");
  assert(runStatus.lookup(publicId) != 0, "Finish or forfeit your run first");
  const mission = hiddenMission();
  assert(mission < 8, "Unknown mission");
  commitments.insert(publicId, missionCommitment(mission, missionSalt()));
  rounds.insert(publicId, (rounds.lookup(publicId) + 1) as Uint<16>);
  moveCounts.insert(publicId, 0);
  runStatus.insert(publicId, 0);
  challengeStatus.insert(publicId, 0);
}
