pragma language_version >= 0.23;

import CompactStandardLibrary;

// Each player owns a random secret. Its hash is the public player ID.
// The mission and secret are provided through local witnesses and never stored.
witness identitySecret(): Bytes<32>;
witness hiddenMission(): Uint<8>;

export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger moveCounts: Map<Bytes<32>, Uint<8>>;
export ledger firstVisits: Map<Bytes<32>, Uint<8>>;
export ledger secondVisits: Map<Bytes<32>, Uint<8>>;
export ledger thirdVisits: Map<Bytes<32>, Uint<8>>;
export ledger fourthVisits: Map<Bytes<32>, Uint<8>>;
export ledger fifthVisits: Map<Bytes<32>, Uint<8>>;
export ledger scores: Map<Bytes<32>, Uint<16>>;
export ledger claimed: Set<Bytes<32>>;
export ledger playerCount: Counter;
export ledger completedMissions: Counter;

export pure circuit playerId(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

export pure circuit missionCommitment(mission: Uint<8>, secret: Bytes<32>): Bytes<32> {
  return persistentCommit<Uint<8>>(mission, secret);
}

export pure circuit missionFirst(mission: Uint<8>): Uint<8> {
  if (mission == 0 || mission == 4) { return 0; }
  if (mission == 1 || mission == 5) { return 1; }
  if (mission == 2 || mission == 6) { return 2; }
  return 3;
}

export pure circuit missionSecond(mission: Uint<8>): Uint<8> {
  if (mission == 0 || mission == 6) { return 1; }
  if (mission == 1 || mission == 4) { return 3; }
  if (mission == 2 || mission == 7) { return 0; }
  return 2;
}

export pure circuit missionThird(mission: Uint<8>): Uint<8> {
  if (mission == 0 || mission == 7) { return 2; }
  if (mission == 1 || mission == 6) { return 0; }
  if (mission == 2 || mission == 5) { return 3; }
  return 1;
}

export pure circuit orderedThree(
  a: Uint<8>, b: Uint<8>, c: Uint<8>,
  one: Uint<8>, two: Uint<8>, three: Uint<8>, four: Uint<8>, five: Uint<8>
): Boolean {
  return (one == a && two == b && three == c)
    || (one == a && two == b && four == c)
    || (one == a && two == b && five == c)
    || (one == a && three == b && four == c)
    || (one == a && three == b && five == c)
    || (one == a && four == b && five == c)
    || (two == a && three == b && four == c)
    || (two == a && three == b && five == c)
    || (two == a && four == b && five == c)
    || (three == a && four == b && five == c);
}

export circuit join(): [] {
  const secret = identitySecret();
  const mission = hiddenMission();
  assert(mission < 8, "Unknown mission");
  const id = disclose(playerId(secret));
  assert(!commitments.member(id), "Player already joined");
  commitments.insert(id, missionCommitment(mission, secret));
  moveCounts.insert(id, 0);
  scores.insert(id, 0);
  playerCount.increment(1);
}

export circuit visit(id: Bytes<32>, location: Uint<8>): [] {
  const publicId = disclose(id);
  const publicLocation = disclose(location);
  assert(commitments.member(publicId), "Join the game first");
  assert(playerId(identitySecret()) == publicId, "Only the player can move");
  assert(publicLocation < 4, "Unknown location");
  assert(!claimed.member(publicId), "Mission already claimed");
  const count = moveCounts.lookup(publicId);
  assert(count < 5, "Five visits already recorded");
  if (count == 0) { firstVisits.insert(publicId, publicLocation); }
  if (count == 1) { secondVisits.insert(publicId, publicLocation); }
  if (count == 2) { thirdVisits.insert(publicId, publicLocation); }
  if (count == 3) { fourthVisits.insert(publicId, publicLocation); }
  if (count == 4) { fifthVisits.insert(publicId, publicLocation); }
  moveCounts.insert(publicId, (count + 1) as Uint<8>);
}

export circuit claim(id: Bytes<32>): [] {
  const publicId = disclose(id);
  assert(commitments.member(publicId), "Join the game first");
  const secret = identitySecret();
  const mission = hiddenMission();
  assert(playerId(secret) == publicId, "Only the player can claim");
  assert(mission < 8, "Unknown mission");
  assert(commitments.lookup(publicId) == missionCommitment(mission, secret), "Mission commitment mismatch");
  assert(moveCounts.lookup(publicId) == 5, "Complete five public visits first");
  assert(!claimed.member(publicId), "Mission already claimed");
  assert(orderedThree(
    missionFirst(mission), missionSecond(mission), missionThird(mission),
    firstVisits.lookup(publicId), secondVisits.lookup(publicId), thirdVisits.lookup(publicId),
    fourthVisits.lookup(publicId), fifthVisits.lookup(publicId)
  ), "Your public visits do not satisfy your secret mission");
  claimed.insert(publicId);
  scores.insert(publicId, (scores.lookup(publicId) + 1) as Uint<16>);
  completedMissions.increment(1);
}
